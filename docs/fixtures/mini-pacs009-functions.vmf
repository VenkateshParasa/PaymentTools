  <validationrules name="Default" type="FieldsValidationRules" id="c6872fe6-539a-4886-8a79-c144c">
    <description><![CDATA[Handles validations which is specified under ISO 20022 Rules.]]></description>
    <hdrvalidationrules><fieldvalidations></fieldvalidations></hdrvalidationrules>
    <datavalidationrules><fieldvalidations>
<fieldvalidation>
  <name>ActiveOrHistoricCurrency</name>
  <fieldname>xmlType=ActiveOrHistoricCurrencyCode &amp; designerType=String</fieldname>
  <formula><![CDATA[IsISOCurrencyCode($value)]]></formula>
  <severity>error</severity>
  <cascade>true</cascade>
  <error-code>D00006</error-code>
  <actionmessage><![CDATA["Must be a valid ActiveOrHistoricCurrency code."]]></actionmessage>
</fieldvalidation>
<fieldvalidation>
  <name>BICFI</name>
  <fieldname>xmlType=BICFIDec2014Identifier</fieldname>
  <formula><![CDATA[IsValidBIC($value)]]></formula>
  <severity>error</severity>
  <cascade>true</cascade>
  <error-code>D00001</error-code>
  <actionmessage><![CDATA["Must be a valid BICFI Code."]]></actionmessage>
</fieldvalidation>
<fieldvalidation>
  <name>Country</name>
  <fieldname>xmlType=CountryCode &amp; designerType=String</fieldname>
  <formula><![CDATA[IsISOCountryCode($value)]]></formula>
  <severity>error</severity>
  <cascade>true</cascade>
  <error-code>D00004</error-code>
  <actionmessage><![CDATA["Must be a valid Country code."]]></actionmessage>
</fieldvalidation>
<fieldvalidation>
  <name>CurrencyAmount</name>
  <fieldname>xmlType=RestrictedFINActiveCurrencyAndAmount</fieldname>
  <formula><![CDATA[if(!IsISOCurrencyCode($value.Ccy)) {
  return false;
}
return IsValidDecimals($value.Ccy, toText($value.Value, false));]]></formula>
  <severity>error</severity>
  <cascade>true</cascade>
  <error-code>D00004</error-code>
  <actionmessage><![CDATA["Must be a valid Currency code."]]></actionmessage>
</fieldvalidation>
    </fieldvalidations></datavalidationrules>
  </validationrules>
  <validationrules name="Extra" type="FieldsValidationRules" id="d1">
    <datavalidationrules><fieldvalidations>
<fieldvalidation>
  <name>MsgIdNoSlash</name>
  <fieldname>xmlType=HVPSPlus_RestrictedFINXMax35Text</fieldname>
  <formula><![CDATA[return !$value.startsWith("/") && !$value.endsWith("/") && !$value.contains("//");]]></formula>
  <severity>error</severity>
  <cascade>true</cascade>
  <error-code>H00001</error-code>
  <actionmessage><![CDATA["Must not start or end with / or contain //."]]></actionmessage>
</fieldvalidation>
<fieldvalidation>
  <name>NeedsLookup</name>
  <fieldname>xmlType=ISODateTime</fieldname>
  <formula><![CDATA[IsBusinessDay($value)]]></formula>
  <severity>warning</severity>
  <cascade>true</cascade>
  <error-code>H00002</error-code>
  <actionmessage><![CDATA["Must be a business day."]]></actionmessage>
</fieldvalidation>
    </fieldvalidations></datavalidationrules>
  </validationrules>
<functions>
  <function>
    <name>HasPrefix</name>
    <parameters><parameter><name>v</name></parameter><parameter><name>p</name></parameter></parameters>
    <body><![CDATA[return v.startsWith(p);]]></body>
  </function>
  <function>
    <name>IsRefOk</name>
    <parameters>v</parameters>
    <implementation><![CDATA[
      if (v.length() < 8) { return false; }
      return HasPrefix(v, "REF") && v.matches("REF[0-9]{5,}");
    ]]></implementation>
  </function>
</functions>
<userfunctions><![CDATA[
  boolean IsEvenDigitSum(String v) {
    int s = 0;
    for (int i = 0; i < v.length(); i++) {
      char c = v.charAt(i);
      if (Character.isDigit(c)) { s += Character.getNumericValue(c); }
    }
    return s % 2 == 0;
  }
  boolean IsValidBIC(String v) { return BicDirectoryLookup(v); }
]]></userfunctions>
<validationrules name="Fn"><datavalidationrules><fieldvalidations>
<fieldvalidation><name>RefFormat</name><fieldname>xmlType=Max15NumericText</fieldname><formula><![CDATA[IsEvenDigitSum($value)]]></formula><severity>error</severity><cascade>true</cascade><error-code>F1</error-code><actionmessage><![CDATA["x"]]></actionmessage></fieldvalidation>
<fieldvalidation><name>EndToEndRef</name><fieldname>xmlType=HVPSPlus_RestrictedFINXMax35Text---copy6 &amp; designerType=String</fieldname><formula><![CDATA[IsRefOk($value)]]></formula><severity>error</severity><cascade>true</cascade><error-code>F2</error-code><actionmessage><![CDATA["x"]]></actionmessage></fieldvalidation>
<fieldvalidation><name>MissingFn</name><fieldname>xmlType=ISODateTime</fieldname><formula><![CDATA[NoSuchFunction($value)]]></formula><severity>error</severity><cascade>true</cascade><error-code>F3</error-code><actionmessage><![CDATA["x"]]></actionmessage></fieldvalidation>
</fieldvalidations></datavalidationrules>
<hdrvalidationrules><fieldvalidations>
<fieldvalidation><name>HeaderRef</name><fieldname>xmlType=HdrRef</fieldname><formula><![CDATA[$value.startsWith("H-") && $value.length() <= 12]]></formula><severity>error</severity><cascade>true</cascade><error-code>H1</error-code><actionmessage><![CDATA["x"]]></actionmessage></fieldvalidation>
</fieldvalidations></hdrvalidationrules></validationrules>
</externalmessage>
